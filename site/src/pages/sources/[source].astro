---
import LegacyRedirect from '../../components/LegacyRedirect.astro';
import { localizedPath } from '../../i18n';
import { loadCatalog } from '../../lib/catalog';
import path from 'node:path';

export async function getStaticPaths() {
  const catalog = await loadCatalog(path.resolve(process.cwd(), '..'));
  return catalog.sources.map((source) => ({ params: { source } }));
}

const source = String(Astro.params.source);
---
<LegacyRedirect target={localizedPath('en', `sources/${source}`)} />
