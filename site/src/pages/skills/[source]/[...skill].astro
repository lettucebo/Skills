---
import LegacyRedirect from '../../../components/LegacyRedirect.astro';
import { localizedPath } from '../../../i18n';
import { loadCatalog } from '../../../lib/catalog';
import path from 'node:path';

export async function getStaticPaths() {
  const catalog = await loadCatalog(path.resolve(process.cwd(), '..'));
  return catalog.skills
    .filter((skill) => !skill.isTombstone)
    .map((skill) => ({
      params: { source: skill.source, skill: skill.slug },
    }));
}

const source = String(Astro.params.source);
const skill = String(Astro.params.skill);
---
<LegacyRedirect target={localizedPath('en', `skills/${source}/${skill}`)} />
