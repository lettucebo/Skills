---
import Layout from '../layouts/Layout.astro';
import {
  loadCatalog,
  computeBaselineVerification,
  formatBaselineVerification,
  getRestrictedSkills,
  RELEASE_VERSION,
  RELEASE_PUBLISHED,
} from '../lib/catalog';
import {
  BUILD_TIME,
  BUILD_COMMIT_SHORT,
  BUILD_COMMIT_URL,
  formatUtc,
} from '../lib/build-info';
import path from 'node:path';

const repoRoot = path.resolve(process.cwd(), '..');
const catalog = await loadCatalog(repoRoot);
const counts = catalog.counts;
const base = import.meta.env.BASE_URL;

const buildTimeLabel = formatUtc(BUILD_TIME);
const registrySyncedLabel = formatUtc(catalog.generatedAt);

const baselineSummary = formatBaselineVerification(
  computeBaselineVerification(catalog.skills),
);
const restrictedSkills = getRestrictedSkills(catalog.skills)
  .slice()
  .sort((a, b) => a.path.localeCompare(b.path));

// Collect upstream repositories and their commits
const upstreamRepos = new Map<string, Set<string>>();
for (const skill of catalog.skills) {
  if (skill.upstreamRepo && skill.upstreamCommit) {
    if (!upstreamRepos.has(skill.upstreamRepo)) {
      upstreamRepos.set(skill.upstreamRepo, new Set());
    }
    upstreamRepos.get(skill.upstreamRepo)!.add(skill.upstreamCommit);
  }
}

const orphanSkills = catalog.skills.filter((s) => s.isOrphan);
---
<Layout title="Status">
  <h1 style="margin-bottom:24px;">Registry Status</h1>

  <div class="status-section">
    <h2>Release</h2>
    <p>
      Version: <strong>v{RELEASE_VERSION}</strong>
      {!RELEASE_PUBLISHED && <span class="badge badge--pending" style="margin-left:8px;">Release pending</span>}
    </p>
    <p style="color:var(--cp-muted-text);font-size:0.875rem;margin-top:8px;">
      {RELEASE_PUBLISHED
        ? `v${RELEASE_VERSION} is published and available for installation.`
        : `v${RELEASE_VERSION} has not been tagged or pushed. Install commands will be available after publication.`
      }
    </p>
  </div>

  <div class="status-section">
    <h2>Build Information</h2>
    <p>
      Site built: <strong><time datetime={BUILD_TIME}>{buildTimeLabel}</time></strong>{
        BUILD_COMMIT_SHORT && BUILD_COMMIT_URL && (
          <Fragment>
            {' from commit '}
            <a href={BUILD_COMMIT_URL} rel="noopener noreferrer"><code>{BUILD_COMMIT_SHORT}</code></a>
          </Fragment>
        )
      }
    </p>
    <p style="color:var(--cp-muted-text);font-size:0.875rem;margin-top:8px;">
      Registry synced: <time datetime={catalog.generatedAt}>{registrySyncedLabel}</time>.
      This is when the lock file was last generated by a sync, which is distinct
      from the site build time above.
    </p>
  </div>

  <div class="status-section">
    <h2>Counts</h2>
    <div class="status-grid">
      <div class="status-stat">
        <div class="stat-value">{counts.total}</div>
        <div class="stat-label">Total Skills</div>
      </div>
      <div class="status-stat">
        <div class="stat-value">{counts.mapped}</div>
        <div class="stat-label">Mapped</div>
      </div>
      <div class="status-stat">
        <div class="stat-value">{counts.orphan}</div>
        <div class="stat-label">Frozen Orphans</div>
      </div>
      <div class="status-stat">
        <div class="stat-value">{counts.local}</div>
        <div class="stat-label">Local</div>
      </div>
      <div class="status-stat">
        <div class="stat-value">{counts.restricted}</div>
        <div class="stat-label">Restricted</div>
      </div>
    </div>
  </div>

  <div class="status-section">
    <h2>Baseline Verification</h2>
    <p>
      <strong>{baselineSummary.headline}</strong> mapped skills have verified baselines.
    </p>
    <p style="color:var(--cp-muted-text);font-size:0.875rem;margin-top:8px;">
      {baselineSummary.detail}
    </p>
  </div>

  <div class="status-section">
    <h2>Upstream Repositories</h2>
    <div class="table-scroll" role="region" aria-label="Upstream repositories" tabindex="0">
      <table class="skill-table">
        <thead>
          <tr>
            <th>Repository</th>
            <th>Resolved Commits</th>
          </tr>
        </thead>
        <tbody>
          {[...upstreamRepos.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([repo, commits]) => (
            <tr>
              <td>
                <a href={`https://github.com/${repo}`} rel="noopener noreferrer">{repo}</a>
              </td>
              <td>
                {[...commits].map((c) => (
                  <code style="margin-right:8px;">{c.slice(0, 7)}</code>
                ))}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="status-section">
    <h2>Frozen Orphans ({orphanSkills.length})</h2>
    {orphanSkills.length > 0 ? (
      <div class="table-scroll" role="region" aria-label="Frozen orphan skills" tabindex="0">
        <table class="skill-table">
          <thead>
            <tr>
              <th>Skill</th>
              <th>Source</th>
              <th>Version</th>
            </tr>
          </thead>
          <tbody>
            {orphanSkills.map((skill) => (
              <tr>
                <td>
                  <a href={`${base}skills/${skill.source}/${skill.slug}/`}>{skill.name}</a>
                </td>
                <td>{skill.source}</td>
                <td>v{skill.version}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p>No orphan skills.</p>
    )}
  </div>

  <div class="status-section">
    <h2>Restricted Skills ({restrictedSkills.length})</h2>
    <p style="color:var(--cp-muted-text);font-size:0.875rem;margin-bottom:8px;">
      Restricted skills have proprietary licenses. Their content is not rendered on this site
      and no install commands are generated.
    </p>
    <ul>
      {restrictedSkills.map((skill) => (
        <li style="font-size:0.875rem;margin-bottom:4px;">
          <code>{skill.path}</code>
        </li>
      ))}
    </ul>
  </div>

  <div class="status-section">
    <h2>Known Limitations</h2>
    <ul style="padding-left:20px;">
      <li style="margin-bottom:8px;">
        <strong>unadopted</strong> status flags are advisory; the website is generated from the
        last committed lock file and does not query upstream at build time.
      </li>
    </ul>
  </div>
</Layout>
