---
import Layout from '../../layouts/Layout.astro';
import InstallCommand from '../InstallCommand.astro';
import LatestIncludedChange from '../LatestIncludedChange.astro';
import {
  formatChangelogDate,
  loadEnrichmentLocale,
  loadSkillChangelog,
  type SkillSummaryContent,
} from '../../lib/enrichment';
import {
  loadSkillBody,
  loadSkillHistory,
  generateSingleSkillInstallCommand,
  buildUpstreamTreeUrl,
  buildUpstreamCommitUrl,
  RELEASE_VERSION,
  RELEASE_PUBLISHED,
  type SkillViewModel,
} from '../../lib/catalog';
import {
  localizedPath,
  statusMessageKey,
  t,
  type Locale,
} from '../../i18n';
import path from 'node:path';

interface Props {
  locale: Locale;
  skill: SkillViewModel;
}

const repoRoot = path.resolve(process.cwd(), '..');

const { locale, skill } = Astro.props;

const body = await loadSkillBody(repoRoot, skill);
const history = await loadSkillHistory(repoRoot, skill);
const noSummary: SkillSummaryContent = {
  purpose: '',
  whenToUse: '',
  outputs: '',
};
const loadedSummary = await loadEnrichmentLocale<SkillSummaryContent>({
  repoRoot,
  kind: 'summaries',
  skill: skill.lockEntry,
  locale,
  fallback: noSummary,
});
const summary = loadedSummary === noSummary ? null : loadedSummary;
const changelog = !skill.isRestricted
  ? await loadSkillChangelog({
      repoRoot,
      skill: skill.lockEntry,
      locale,
    })
  : null;
const upstreamChanges = changelog?.content ?? { commits: [] };
const latestIncludedChange = changelog?.latestIncludedChange ?? null;
const installCmd = skill.isRestricted
  ? null
  : generateSingleSkillInstallCommand(skill.name);
const upstreamTreeUrl = buildUpstreamTreeUrl(skill);
const upstreamCommitUrl = buildUpstreamCommitUrl(skill);

function statusBadgeClass(): string {
  if (skill.isRestricted) return 'badge badge--restricted';
  if (skill.isOrphan) return 'badge badge--frozen';
  if (skill.isLocal) return 'badge badge--local';
  return 'badge badge--synced';
}
---
<Layout title={skill.name} locale={locale}>
  <nav class="breadcrumbs" aria-label={t(locale, 'breadcrumb')}>
    <a href={localizedPath(locale)}>{t(locale, 'navCatalog')}</a>
    <span aria-hidden="true">/</span>
    <a href={localizedPath(locale, `sources/${skill.source}`)}>{skill.source}</a>
    <span aria-hidden="true">/</span>
    <span>{skill.name}</span>
  </nav>

  <article data-pagefind-body>
    <span id="latest-included-change-description" class="visually-hidden" data-pagefind-ignore>
      {t(locale, 'latestIncludedChangeClarification')}
    </span>
    <div class="detail-header">
      <h1>{skill.name}</h1>
      <div class="detail-meta">
        <span class={statusBadgeClass()}>{t(locale, statusMessageKey(skill.statusLabel))}</span>
        <span data-pagefind-filter="origin" hidden>{skill.statusLabel}</span>
        <span data-pagefind-meta="version">v{skill.version}</span>
        <span data-pagefind-filter="license" data-pagefind-meta="license" hidden>{skill.license}</span>
        {skill.license && skill.license !== 'Unknown' && (
          <span>{t(locale, 'license')}: {skill.license}</span>
        )}
        <span data-pagefind-filter="source" data-pagefind-meta="source" hidden>{skill.source}</span>
        {skill.upstreamRepo && (
          <span>
            {t(locale, 'source')}: {upstreamTreeUrl && skill.upstreamSource ? (
              <a href={upstreamTreeUrl} rel="noopener noreferrer">{skill.upstreamRepo}/{skill.upstreamSource}</a>
            ) : (
              <a href={`https://github.com/${skill.upstreamRepo}`} rel="noopener noreferrer">{skill.upstreamRepo}</a>
            )}
          </span>
        )}
        {skill.upstreamCommit && (
          <span>
            {t(locale, 'commit')}: {upstreamCommitUrl ? (
              <a href={upstreamCommitUrl} rel="noopener noreferrer"><code>{skill.upstreamCommit.slice(0, 7)}</code></a>
            ) : (
              <code>{skill.upstreamCommit.slice(0, 7)}</code>
            )}
          </span>
        )}
        {!skill.isRestricted && latestIncludedChange && (
          <LatestIncludedChange
            locale={locale}
            value={latestIncludedChange}
            descriptionId="latest-included-change-description"
          />
        )}
      </div>
    </div>

    {body?.description && (
      <p class="detail-description" style="color:var(--cp-muted-text);margin-bottom:16px;">{body.description}</p>
    )}

    {summary && (
      <section class="skill-summary" aria-labelledby="skill-summary-heading">
        <h2 id="skill-summary-heading">{t(locale, 'summary')}</h2>
        <dl>
          <div>
            <dt>{t(locale, 'purpose')}</dt>
            <dd>{summary.purpose}</dd>
          </div>
          <div>
            <dt>{t(locale, 'whenToUse')}</dt>
            <dd>{summary.whenToUse}</dd>
          </div>
          <div>
            <dt>{t(locale, 'outputs')}</dt>
            <dd>{summary.outputs}</dd>
          </div>
        </dl>
      </section>
    )}

    {skill.isOrphan && (
      <div class="info-box">
        <strong>{t(locale, 'frozenWarning')}</strong>
        <p>
          {t(locale, 'frozenDetail', { version: skill.version })}
        </p>
      </div>
    )}

    {upstreamChanges.commits.length > 0 && latestIncludedChange?.date && (
      <details class="upstream-changes" data-pagefind-ignore>
        <summary>
          {t(locale, 'upstreamChangesSummary', {
            count: upstreamChanges.commits.length,
            date: formatChangelogDate(latestIncludedChange.date),
          })}
        </summary>
        <div class="timeline upstream-changes-timeline">
          {upstreamChanges.commits.map((entry) => (
            <div class="timeline-entry">
              <a
                class="timeline-version"
                href={entry.url}
                rel="noopener noreferrer"
              >
                <code>{entry.sha.slice(0, 7)}</code>
              </a>
              <time datetime={entry.date}>{formatChangelogDate(entry.date)}</time>
              <span class="timeline-subject">{entry.subject}</span>
              {entry.summary && <span class="timeline-summary">{entry.summary}</span>}
            </div>
          ))}
          {upstreamChanges.truncatedAt && (
            <p class="timeline-note">
              {t(locale, 'earlierHistoryTruncated')}{' '}
              <code>{upstreamChanges.truncatedAt.sha.slice(0, 7)}</code>.
            </p>
          )}
        </div>
      </details>
    )}

    {!skill.isRestricted && installCmd && (
      <div data-pagefind-ignore>
        <InstallCommand command={installCmd} locale={locale} />
      </div>
    )}

    {!skill.isRestricted && body?.renderedBody && (
      <div class="detail-body">
        <Fragment set:html={body.renderedBody} />
      </div>
    )}
  </article>

  {history.length > 0 && (
    <div class="timeline" data-pagefind-ignore>
      <h2>{t(locale, 'history')}</h2>
      {history.map((entry) => (
        <div class="timeline-entry">
          <span class="timeline-version">v{entry.version}</span>
          <span class="timeline-kind">{entry.kind}</span>
          {entry.upstreamCommit && (
            <span><code>{String(entry.upstreamCommit).slice(0, 7)}</code></span>
          )}
        </div>
      ))}
    </div>
  )}
</Layout>
