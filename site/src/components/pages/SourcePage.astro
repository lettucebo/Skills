---
import Layout from '../../layouts/Layout.astro';
import InstallCommand from '../InstallCommand.astro';
import LatestIncludedChange from '../LatestIncludedChange.astro';
import {
  loadCatalog,
  getSkillsBySource,
  getUpstreamRepoForSource,
  generateSourceInstallCommand,
  RELEASE_VERSION,
  RELEASE_PUBLISHED,
} from '../../lib/catalog';
import {
  loadSkillChangelog,
  type LatestIncludedChange as LatestIncludedChangeValue,
} from '../../lib/enrichment';
import {
  localizedPath,
  statusMessageKey,
  t,
  type Locale,
} from '../../i18n';
import path from 'node:path';

interface Props {
  locale: Locale;
  source: string;
}

const repoRoot = path.resolve(process.cwd(), '..');
const { locale, source } = Astro.props;
const catalog = await loadCatalog(repoRoot);
const skills = getSkillsBySource(catalog.skills, source);
const upstreamRepo = getUpstreamRepoForSource(catalog.skills, source);
const sourceCmd = generateSourceInstallCommand(catalog.skills, source);
const latestIncludedChanges = new Map<string, LatestIncludedChangeValue>(
  await Promise.all(
    skills
      .filter((skill) => !skill.isRestricted)
      .map(async (skill) => {
        const changelog = await loadSkillChangelog({
          repoRoot,
          skill: skill.lockEntry,
          locale,
        });
        return [skill.path, changelog!.latestIncludedChange] as const;
      }),
  ),
);
---
<Layout title={t(locale, 'sourcePageTitle', { source })} locale={locale}>
  <nav class="breadcrumbs" aria-label={t(locale, 'breadcrumb')}>
    <a href={localizedPath(locale)}>{t(locale, 'navCatalog')}</a>
    <span aria-hidden="true">/</span>
    <span>{source}</span>
  </nav>

  <div class="source-header">
    <h1>{source}</h1>
    <p class="source-meta">
      {t(locale, skills.length === 1 ? 'sourceSkillsOne' : 'sourceSkillsOther', { count: skills.length })}
      {upstreamRepo && (
        <span>
          &middot; {t(locale, 'upstream')}: <a href={`https://github.com/${upstreamRepo}`} rel="noopener noreferrer">{upstreamRepo}</a>
        </span>
      )}
    </p>
  </div>

  <span id="latest-included-change-description" class="visually-hidden" data-pagefind-ignore>
    {t(locale, 'latestIncludedChangeClarification')}
  </span>

  {sourceCmd && (
    <InstallCommand command={sourceCmd} locale={locale} />
  )}

  <div class="table-scroll" role="region" aria-label={t(locale, 'skillsInSource', { source })} tabindex="0">
    <table class="skill-table">
      <thead>
        <tr>
          <th>{t(locale, 'skill')}</th>
          <th>{t(locale, 'version')}</th>
          <th>{t(locale, 'status')}</th>
          <th>{t(locale, 'license')}</th>
          <th>{t(locale, 'latestIncludedChange')}</th>
        </tr>
      </thead>
      <tbody>
        {skills.map((skill) => (
          <tr>
            <td>
              <a href={localizedPath(locale, `skills/${skill.source}/${skill.slug}`)}>{skill.name}</a>
            </td>
            <td>v{skill.version}</td>
            <td>
              <span class={`badge badge--${skill.isRestricted ? 'restricted' : skill.isOrphan ? 'frozen' : skill.isLocal ? 'local' : 'synced'}`}>
                {t(locale, statusMessageKey(skill.statusLabel))}
              </span>
            </td>
            <td>{skill.license}</td>
            <td>
              {!skill.isRestricted && latestIncludedChanges.has(skill.path) && (
                <LatestIncludedChange
                  locale={locale}
                  value={latestIncludedChanges.get(skill.path)!}
                  showLabel={false}
                  descriptionId="latest-included-change-description"
                />
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>
