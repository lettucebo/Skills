---
/**
 * Search component — progressive-enhancement search over the All Skills grid.
 *
 * There is ONE catalog grid (rendered by index.astro as `#skill-grid` with
 * `[data-skill-card]` cards). This component owns only the input, the filter
 * dropdowns, and a single polite live region; searching and filtering hide the
 * non-matching existing cards instead of building a second list.
 *
 *  - Dropdown filters are Pagefind-independent: they match the card `data-*`
 *    attributes directly, so filtering works under `astro dev` (no index) and
 *    when Pagefind fails to load.
 *  - A non-empty text query loads Pagefind and keeps only the cards whose URL
 *    appears in the result set (intersected with any active dropdown filters).
 *
 * Deterministic sorted options are generated at build time from the catalog so
 * the dropdowns work even before the client script runs.
 */
import { loadCatalog } from '../lib/catalog';
import { statusMessageKey, t, type Locale } from '../i18n';
import path from 'node:path';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const repoRoot = path.resolve(process.cwd(), '..');
const catalog = await loadCatalog(repoRoot);
const base = import.meta.env.BASE_URL;

const sources = [...new Set(
  catalog.skills.filter(s => !s.isTombstone).map(s => s.source),
)].sort();

const licenses = [...new Set(
  catalog.skills.filter(s => !s.isTombstone).map(s => s.license),
)].sort();

const origins = [...new Set(
  catalog.skills.filter(s => !s.isTombstone).map(s => s.statusLabel),
)].sort();
const clientMessages = {
  noMatching: t(locale, 'noMatchingSkills'),
  resultFound: t(locale, 'resultFound'),
  resultsFound: t(locale, 'resultsFound'),
  unavailableFilter: t(locale, 'searchUnavailableFilter'),
  unavailableAll: t(locale, 'searchUnavailableAll'),
};
---

<div class="search-section" id="search-section">
  <noscript>
    <style>.search-box, .filter-controls { display: none !important; }</style>
    <p class="info-box">{t(locale, 'searchRequiresJs')}</p>
  </noscript>

  <div class="search-box">
    <label for="search-input" class="sr-only">{t(locale, 'searchSkills')}</label>
    <input
      type="search"
      id="search-input"
      class="search-input"
      placeholder={t(locale, 'searchPlaceholder')}
      autocomplete="off"
    />
  </div>

  <div class="filter-controls" role="group" aria-label={t(locale, 'searchFilters')}>
    <label>
      <span class="sr-only">{t(locale, 'filterBySource')}</span>
      <select id="filter-source" class="filter-select">
        <option value="">{t(locale, 'allSources')}</option>
        {sources.map(s => <option value={s}>{s}</option>)}
      </select>
    </label>

    <label>
      <span class="sr-only">{t(locale, 'filterByLicense')}</span>
      <select id="filter-license" class="filter-select">
        <option value="">{t(locale, 'allLicenses')}</option>
        {licenses.map(l => <option value={l}>{l}</option>)}
      </select>
    </label>

    <label>
      <span class="sr-only">{t(locale, 'filterByOrigin')}</span>
      <select id="filter-origin" class="filter-select">
        <option value="">{t(locale, 'allOrigins')}</option>
        {origins.map(o => <option value={o}>{t(locale, statusMessageKey(o))}</option>)}
      </select>
    </label>
  </div>

  <p
    id="search-status"
    class="search-status"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    data-search-generation="0"
    data-search-state="idle"
  ></p>
</div>

<script define:vars={{ base, clientMessages }}>
  /**
   * Unified search/filter over the existing catalog cards.
   *
   * Filtering is Pagefind-independent (data-* attribute matching). A non-empty
   * text query additionally loads Pagefind and restricts the visible cards to
   * the result URLs. Pagefind failure is non-fatal: the dropdown filters stay
   * applied and a precise message is announced. A monotonic generation token
   * ensures a slow older request can never overwrite newer input/filter state.
   */
  (function () {
     function initializeSearch() {
     const PAGEFIND_PATH = base + 'pagefind/pagefind.js';
    let pagefind = null;
    let pagefindLoad = null;
    let loadAttempt = 0;

    const searchInput = document.getElementById('search-input');
    const filterSource = document.getElementById('filter-source');
    const filterLicense = document.getElementById('filter-license');
    const filterOrigin = document.getElementById('filter-origin');
    const statusEl = document.getElementById('search-status');
    const groupControls = document.getElementById('catalog-group-controls');
    const expandAllBtn = document.getElementById('expand-all-groups');
    const collapseAllBtn = document.getElementById('collapse-all-groups');

    if (!searchInput || !statusEl) return;

    async function loadPagefind() {
      if (pagefind) return pagefind;
      if (!pagefindLoad) {
        const specifier = loadAttempt === 0
          ? PAGEFIND_PATH
          : PAGEFIND_PATH + '?retry=' + loadAttempt;
        loadAttempt += 1;
        pagefindLoad = import(specifier)
          .then(async function (mod) {
            await mod.options({ baseUrl: base });
            pagefind = mod;
            return mod;
          })
          .catch(function (error) {
            pagefindLoad = null;
            throw error;
          });
      }
      return pagefindLoad;
    }

    let debounceTimer = null;
    let generation = 0;

    function getCards() {
      // Cards are matched by attribute, not by parent, so future per-source
      // <details> grouping (T6) does not break this lookup.
      return Array.prototype.slice.call(document.querySelectorAll('[data-skill-card]'));
    }

    // Source folders wrap the cards in native <details>. Group lookup is
    // attribute-based (not a direct-child relationship) so it survives markup
    // reshuffles, and it never touches card `hidden` flags — the heading/status
    // count is the number of matching cards, while folder open state only
    // controls browsing.
    function getGroups() {
      return Array.prototype.slice.call(document.querySelectorAll('[data-skill-group]'));
    }

    function groupHasVisibleCard(group) {
      const groupCards = group.querySelectorAll('[data-skill-card]');
      for (let i = 0; i < groupCards.length; i += 1) {
        if (!groupCards[i].hidden) return true;
      }
      return false;
    }

    // Keep every folder in step with the applied card visibility. When a query
    // or filter is active, folders with a match open and folders with none are
    // hidden; when nothing is active, every folder is revealed and collapsed
    // again (regardless of any prior manual Expand all).
    function syncGroups(active) {
      const groups = getGroups();
      for (const group of groups) {
        if (!active) {
          group.hidden = false;
          group.open = false;
          continue;
        }
        if (groupHasVisibleCard(group)) {
          group.hidden = false;
          group.open = true;
        } else {
          group.hidden = true;
          group.open = false;
        }
      }
    }

    // Expand/Collapse act only on folders the current search left visible, and
    // never change which cards are hidden.
    function setOpenOnVisibleGroups(open) {
      for (const group of getGroups()) {
        if (!group.hidden) group.open = open;
      }
    }

    function currentFilters() {
      return {
        source: filterSource && filterSource.value ? filterSource.value : '',
        license: filterLicense && filterLicense.value ? filterLicense.value : '',
        origin: filterOrigin && filterOrigin.value ? filterOrigin.value : '',
      };
    }

    function cardMatchesFilters(card, filters) {
      if (filters.source && card.getAttribute('data-source') !== filters.source) return false;
      if (filters.license && card.getAttribute('data-license') !== filters.license) return false;
      if (filters.origin && card.getAttribute('data-origin') !== filters.origin) return false;
      return true;
    }

    function normalizeUrl(url) {
      if (!url) return '';
      let u = String(url).split('#')[0].split('?')[0];
      const scheme = u.indexOf('://');
      if (scheme !== -1) {
        const rest = u.slice(scheme + 3);
        const slash = rest.indexOf('/');
        u = slash === -1 ? '/' : rest.slice(slash);
      }
      if (u.charAt(u.length - 1) !== '/') u += '/';
      return u;
    }

    function pagefindFilters(filters) {
      const out = {};
      if (filters.source) out.source = filters.source;
      if (filters.license) out.license = filters.license;
      if (filters.origin) out.origin = filters.origin;
      return out;
    }

    function applyVisibility(cards, predicate) {
      let visible = 0;
      for (const card of cards) {
        const show = predicate(card);
        card.hidden = !show;
        if (show) visible += 1;
      }
      return visible;
    }

    function updateCount(value) {
      const countEl = document.getElementById('catalog-count');
      if (countEl) countEl.textContent = String(value);
    }

    // The live region is written only after visibility is applied, so the
    // announced count always equals the number of visible cards.
    function announceCount(visible) {
      const template = visible === 0
        ? clientMessages.noMatching
        : visible === 1
          ? clientMessages.resultFound
          : clientMessages.resultsFound;
      statusEl.textContent = template.replace('{count}', String(visible));
    }

    function announceUnavailable(visible, hasFilters) {
      const template = hasFilters
        ? clientMessages.unavailableFilter
        : clientMessages.unavailableAll;
      statusEl.textContent = template
        .replace('{count}', String(visible))
        .replace('{suffix}', visible !== 1 ? (hasFilters ? 'es' : 's') : '');
    }

    function markSearchState(gen, state) {
      statusEl.dataset.searchGeneration = String(gen);
      statusEl.dataset.searchState = state;
    }

    async function doSearch(requestGeneration) {
      const gen = requestGeneration === undefined ? ++generation : requestGeneration;
      if (gen !== generation) return;
      markSearchState(gen, 'pending');
      const query = searchInput.value.trim();
      const filters = currentFilters();
      const hasFilters = !!(filters.source || filters.license || filters.origin);
      const cards = getCards();
      const total = cards.length;

      // Nothing active: restore every card, clear the live region.
      if (!query && !hasFilters) {
        for (const card of cards) card.hidden = false;
        syncGroups(false);
        statusEl.textContent = '';
        updateCount(total);
        markSearchState(gen, 'settled');
        return;
      }

      // Filter-only: Pagefind-independent card matching.
      if (!query) {
        const visible = applyVisibility(cards, function (c) { return cardMatchesFilters(c, filters); });
        syncGroups(true);
        announceCount(visible);
        updateCount(visible);
        markSearchState(gen, 'settled');
        return;
      }

      // Text query: load Pagefind, then intersect its result URLs with filters.
      let pf;
      try {
        pf = await loadPagefind();
      } catch (err) {
        if (gen !== generation) return;
        const visible = applyVisibility(cards, function (c) { return cardMatchesFilters(c, filters); });
        syncGroups(true);
        announceUnavailable(visible, hasFilters);
        updateCount(visible);
        markSearchState(gen, 'settled');
        console.error('Pagefind load error:', err);
        return;
      }
      if (gen !== generation) return;

      let urlSet;
      try {
        const search = await pf.search(query, { filters: pagefindFilters(filters) });
        if (gen !== generation) return;
        const data = await Promise.all(search.results.map(function (r) { return r.data(); }));
        if (gen !== generation) return;
        urlSet = new Set(data.map(function (d) { return normalizeUrl(d && d.url); }));
      } catch (err) {
        if (gen !== generation) return;
        const visible = applyVisibility(cards, function (c) { return cardMatchesFilters(c, filters); });
        syncGroups(true);
        announceUnavailable(visible, hasFilters);
        updateCount(visible);
        markSearchState(gen, 'settled');
        console.error('Pagefind search error:', err);
        return;
      }

      if (gen !== generation) return;
      const visible = applyVisibility(cards, function (c) {
        return urlSet.has(normalizeUrl(c.getAttribute('data-url'))) && cardMatchesFilters(c, filters);
      });
      syncGroups(true);
      announceCount(visible);
      updateCount(visible);
      markSearchState(gen, 'settled');
    }

    searchInput.addEventListener('input', function () {
      const gen = ++generation;
      markSearchState(gen, 'pending');
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function () { doSearch(gen); }, 200);
    });

    // Filters respond immediately; only text input is debounced.
    [filterSource, filterLicense, filterOrigin].forEach(function (el) {
      if (el) el.addEventListener('change', function () { return doSearch(); });
    });

    // Expand/Collapse are useful only with JS, so they stay hidden in markup
    // and are revealed here. They operate on whatever folders the current
    // search left visible and never change card visibility.
    if (expandAllBtn) {
      expandAllBtn.addEventListener('click', function () { setOpenOnVisibleGroups(true); });
    }
    if (collapseAllBtn) {
      collapseAllBtn.addEventListener('click', function () { setOpenOnVisibleGroups(false); });
    }
    if (groupControls) groupControls.hidden = false;

    doSearch();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeSearch, { once: true });
    } else {
      initializeSearch();
    }
  })();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-section {
    margin-bottom: 24px;
  }

  .search-box {
    margin-bottom: 12px;
  }

  .search-input {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--cp-border);
    border-radius: 0.625rem;
    background: var(--cp-surface);
    color: var(--cp-text);
    font-size: 0.9375rem;
    font-family: inherit;
    transition: border-color 0.15s;
  }
  .search-input:focus {
    outline: 2px solid var(--cp-accent);
    outline-offset: 2px;
    border-color: var(--cp-accent);
  }
  .search-input::placeholder {
    color: var(--cp-muted-text);
  }

  .filter-controls {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .filter-select {
    padding: 6px 12px;
    border: 1px solid var(--cp-border);
    border-radius: 0.625rem;
    background: var(--cp-surface);
    color: var(--cp-text);
    font-size: 0.8125rem;
    font-family: inherit;
    cursor: pointer;
  }
  .filter-select:focus {
    outline: 2px solid var(--cp-accent);
    outline-offset: 2px;
  }

  .search-status {
    font-size: 0.8125rem;
    color: var(--cp-muted-text);
    margin-bottom: 12px;
    min-height: 1.2em;
  }

  @media (prefers-reduced-motion: reduce) {
    .search-input {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .filter-controls {
      flex-direction: column;
    }
    .filter-select {
      width: 100%;
    }
  }
</style>
