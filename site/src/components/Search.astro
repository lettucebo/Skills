---
/**
 * Search component — progressive-enhancement search powered by Pagefind.
 * Works under any base path; uses Clawpilot design tokens; shows loading,
 * no-result, and error states without silently failing.
 *
 * Filters: source, license, origin.  Deterministic sorted options are
 * generated at build time from the catalog so the UI works even before
 * Pagefind JS loads (the dropdowns also drive client-side card filtering).
 */
import { loadCatalog } from '../lib/catalog';
import path from 'node:path';

const repoRoot = path.resolve(process.cwd(), '..');
const catalog = await loadCatalog(repoRoot);
const base = import.meta.env.BASE_URL;

const sources = [...new Set(
  catalog.skills.filter(s => !s.isTombstone).map(s => s.source),
)].sort();

const licenses = [...new Set(
  catalog.skills.filter(s => !s.isTombstone).map(s => s.license),
)].sort();

const origins = [...new Set(
  catalog.skills.filter(s => !s.isTombstone).map(s => s.statusLabel),
)].sort();
---

<div class="search-section" id="search-section">
  <noscript>
    <p class="info-box">Search and filter require JavaScript. You can browse the full catalog below.</p>
  </noscript>

  <div class="search-box">
    <label for="search-input" class="sr-only">Search skills</label>
    <input
      type="search"
      id="search-input"
      class="search-input"
      placeholder="Search skills…"
      autocomplete="off"
    />
  </div>

  <div class="filter-controls" role="group" aria-label="Search filters">
    <label>
      <span class="sr-only">Filter by source</span>
      <select id="filter-source" class="filter-select">
        <option value="">All sources</option>
        {sources.map(s => <option value={s}>{s}</option>)}
      </select>
    </label>

    <label>
      <span class="sr-only">Filter by license</span>
      <select id="filter-license" class="filter-select">
        <option value="">All licenses</option>
        {licenses.map(l => <option value={l}>{l}</option>)}
      </select>
    </label>

    <label>
      <span class="sr-only">Filter by origin</span>
      <select id="filter-origin" class="filter-select">
        <option value="">All origins</option>
        {origins.map(o => <option value={o}>{o}</option>)}
      </select>
    </label>
  </div>

  <div
    id="search-results"
    class="search-results"
    role="region"
    aria-live="polite"
    aria-label="Search results"
    hidden
  >
    <p id="search-status" class="search-status"></p>
    <ul id="search-result-list" class="search-result-list"></ul>
  </div>
</div>

<script define:vars={{ base }}>
  /**
   * Pagefind client-side search integration.
   * Loads pagefind from the site base path (e.g. /Skills/pagefind/pagefind.js).
   * Gracefully degrades — if Pagefind fails to load, search shows an error
   * message and the catalog card grid + filters remain browse-able.
   */
  (function () {
    const PAGEFIND_PATH = base + 'pagefind/pagefind.js';
    let pagefind = null;

    const searchInput = document.getElementById('search-input');
    const filterSource = document.getElementById('filter-source');
    const filterLicense = document.getElementById('filter-license');
    const filterOrigin = document.getElementById('filter-origin');
    const resultsContainer = document.getElementById('search-results');
    const statusEl = document.getElementById('search-status');
    const resultList = document.getElementById('search-result-list');
    const fullCatalog = document.getElementById('full-catalog');

    if (!searchInput || !resultsContainer || !statusEl || !resultList) return;

    async function loadPagefind() {
      if (pagefind) return pagefind;
      statusEl.textContent = 'Loading search index…';
      resultsContainer.hidden = false;
      try {
        const mod = await import(PAGEFIND_PATH);
        await mod.options({ baseUrl: base });
        pagefind = mod;
        return pagefind;
      } catch (err) {
        statusEl.textContent = 'Search is unavailable — index could not be loaded.';
        if (fullCatalog) fullCatalog.hidden = false;
        console.error('Pagefind load error:', err);
        return null;
      }
    }

    let debounceTimer = null;

    function buildFilters() {
      const filters = {};
      if (filterSource && filterSource.value) filters.source = filterSource.value;
      if (filterLicense && filterLicense.value) filters.license = filterLicense.value;
      if (filterOrigin && filterOrigin.value) filters.origin = filterOrigin.value;
      return filters;
    }

    async function doSearch() {
      const query = searchInput.value.trim();
      const filters = buildFilters();
      const hasFilters = Object.keys(filters).length > 0;

      if (!query && !hasFilters) {
        resultsContainer.hidden = true;
        resultList.innerHTML = '';
        statusEl.textContent = '';
        if (fullCatalog) fullCatalog.hidden = false;
        return;
      }

      if (fullCatalog) fullCatalog.hidden = true;

      const pf = await loadPagefind();
      if (!pf) return;

      statusEl.textContent = 'Searching…';
      resultsContainer.hidden = false;

      try {
        const search = await pf.search(query || null, { filters });
        if (search.results.length === 0) {
          statusEl.textContent = 'No matching skills found.';
          resultList.innerHTML = '';
          return;
        }

        statusEl.textContent = search.results.length + ' result' +
          (search.results.length !== 1 ? 's' : '') + ' found.';

        const data = await Promise.all(
          search.results.map(r => r.data()),
        );

        resultList.innerHTML = data.map(function (item) {
          const meta = item.meta || {};
          const filters = item.filters || {};
          const source = (filters.source || [''])[0];
          const version = meta.version || '';
          const origin = (filters.origin || [''])[0];
          const license = (filters.license || [''])[0];

          return '<li class="search-result-item">' +
            '<a href="' + escapeAttr(item.url) + '" class="search-result-link">' +
            '<span class="search-result-title">' + escapeHtml(meta.title || item.url) + '</span>' +
            '<span class="search-result-meta">' +
              (source ? '<span>' + escapeHtml(source) + '</span>' : '') +
              (version ? '<span>' + escapeHtml(version) + '</span>' : '') +
              (origin ? '<span class="badge badge--' + badgeType(origin) + '">' + escapeHtml(origin) + '</span>' : '') +
              (license && license !== 'Unknown' ? '<span>' + escapeHtml(license) + '</span>' : '') +
            '</span>' +
            (item.excerpt ? '<span class="search-result-excerpt">' + item.excerpt + '</span>' : '') +
            '</a>' +
            '</li>';
        }).join('');
      } catch (err) {
        statusEl.textContent = 'Search error — please try again.';
        if (fullCatalog) fullCatalog.hidden = false;
        console.error('Pagefind search error:', err);
      }
    }

    function badgeType(origin) {
      switch (origin) {
        case 'Restricted': return 'restricted';
        case 'Frozen': return 'frozen';
        case 'Local': return 'local';
        default: return 'synced';
      }
    }

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function escapeAttr(str) {
      return str.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    searchInput.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(doSearch, 200);
    });

    [filterSource, filterLicense, filterOrigin].forEach(function (el) {
      if (el) el.addEventListener('change', doSearch);
    });
  })();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-section {
    margin-bottom: 24px;
  }

  .search-box {
    margin-bottom: 12px;
  }

  .search-input {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--cp-border);
    border-radius: 0.625rem;
    background: var(--cp-surface);
    color: var(--cp-text);
    font-size: 0.9375rem;
    font-family: inherit;
    transition: border-color 0.15s;
  }
  .search-input:focus {
    outline: 2px solid var(--cp-accent);
    outline-offset: 2px;
    border-color: var(--cp-accent);
  }
  .search-input::placeholder {
    color: var(--cp-text-muted);
  }

  .filter-controls {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .filter-select {
    padding: 6px 12px;
    border: 1px solid var(--cp-border);
    border-radius: 0.625rem;
    background: var(--cp-surface);
    color: var(--cp-text);
    font-size: 0.8125rem;
    font-family: inherit;
    cursor: pointer;
  }
  .filter-select:focus {
    outline: 2px solid var(--cp-accent);
    outline-offset: 2px;
  }

  .search-status {
    font-size: 0.8125rem;
    color: var(--cp-text-muted);
    margin-bottom: 12px;
  }

  .search-result-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .search-result-item {
    border-bottom: 1px solid var(--cp-border);
  }
  .search-result-item:last-child {
    border-bottom: none;
  }

  .search-result-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 8px;
    text-decoration: none;
    border-radius: 0.625rem;
    transition: background 0.15s;
  }
  .search-result-link:hover {
    background: var(--cp-accent-soft);
    text-decoration: none;
  }
  .search-result-link:focus-visible {
    outline: 2px solid var(--cp-accent);
    outline-offset: 2px;
  }

  .search-result-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--cp-text);
  }

  .search-result-meta {
    font-size: 0.75rem;
    color: var(--cp-text-muted);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }

  .search-result-excerpt {
    font-size: 0.8125rem;
    color: var(--cp-text-soft);
    line-height: 1.5;
  }
  .search-result-excerpt :global(mark) {
    background: var(--cp-highlight);
    color: inherit;
    border-radius: 2px;
    padding: 0 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .search-input,
    .search-result-link {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .filter-controls {
      flex-direction: column;
    }
    .filter-select {
      width: 100%;
    }
  }
</style>
