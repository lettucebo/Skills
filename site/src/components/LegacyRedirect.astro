---
import {
  HTML_LANG,
  LOCALE_DISPLAY_NAMES,
  SUPPORTED_LOCALES,
  localizedPath,
  routeForLocale,
  t,
} from '../i18n';

interface Props {
  target: string;
  detectLocale?: boolean;
}

const { target, detectLocale = false } = Astro.props;
const canonical = new URL(target, Astro.site);
const localeLinks = SUPPORTED_LOCALES.map((locale) => ({
  locale,
  href: routeForLocale(locale, target),
}));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t('en', 'redirecting')} | {t('en', 'titleSuffix')}</title>
  <link rel="canonical" href={canonical} />
  {detectLocale && (
    <script
      is:inline
      define:vars={{
        supportedLocales: SUPPORTED_LOCALES,
        englishTarget: target,
        localeTargets: Object.fromEntries(
          SUPPORTED_LOCALES.map((locale) => [locale, localizedPath(locale)]),
        ),
      }}
    >
      (() => {
        let selected = null;
        try {
          const saved = localStorage.getItem('skillsLocale');
          if (supportedLocales.includes(saved)) selected = saved;
        } catch {}
        if (!selected) {
          const languages = navigator.languages?.length
            ? navigator.languages
            : [navigator.language];
          for (const language of languages) {
            const normalized = String(language || '').toLowerCase();
            if (normalized.startsWith('zh-hant') || /zh-(tw|hk|mo)/.test(normalized)) {
              selected = 'zh-tw';
              break;
            }
            if (normalized.startsWith('zh')) {
              selected = 'zh-cn';
              break;
            }
            if (normalized.startsWith('en')) {
              selected = 'en';
              break;
            }
          }
        }
        const destination = localeTargets[selected] || englishTarget;
        if (destination !== englishTarget) location.replace(destination);
      })();
    </script>
  )}
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <style is:inline>
    body {
      margin: 1rem;
      background: Canvas;
      color: CanvasText;
      font-family: "Segoe UI", Aptos, Calibri, sans-serif;
    }
    a {
      color: LinkText;
    }
    .language-menu {
      position: relative;
      display: inline-block;
    }
    .language-menu-summary {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding-block: 0.375rem;
      padding-inline: 0.625rem;
      border: 1px solid ButtonText;
      border-radius: 0.625rem;
      background: Canvas;
      color: CanvasText;
      cursor: pointer;
      list-style: none;
    }
    .language-menu-summary::-webkit-details-marker {
      display: none;
    }
    .language-menu-summary:focus-visible,
    .language-menu-list a:focus-visible {
      outline: 2px solid Highlight;
      outline-offset: 2px;
    }
    .language-menu-summary::after {
      content: '';
      width: 0;
      height: 0;
      border-inline: 4px solid transparent;
      border-top: 5px solid currentColor;
      transition: transform 0.15s;
      flex: 0 0 auto;
    }
    .language-menu[open] .language-menu-summary::after {
      transform: rotate(180deg);
    }
    @media (prefers-reduced-motion: reduce) {
      .language-menu-summary::after {
        transition: none;
      }
    }
    .language-menu-list {
      position: absolute;
      z-index: 1;
      inset-block-start: calc(100% + 0.375rem);
      min-inline-size: 10rem;
      max-inline-size: calc(100vw - 2rem);
      padding-block: 0.25rem;
      list-style: none;
      border: 1px solid ButtonText;
      border-radius: 0.625rem;
      background: Canvas;
    }
    .legacy-language-menu .language-menu-list {
      inset-inline-start: 0;
      inset-inline-end: auto;
    }
    .language-menu-list a {
      display: block;
      padding-block: 0.375rem;
      padding-inline: 0.75rem;
    }
    .language-menu-list a[aria-current="page"] {
      background: SelectedItem;
      color: SelectedItemText;
      font-weight: 600;
    }
    @media (forced-colors: active) {
      .language-menu-summary,
      .language-menu-list {
        border: 1px solid ButtonText;
      }
      .language-menu-summary::after {
        border-top-color: ButtonText;
        border-inline-color: Canvas;
      }
      .language-menu-list a[aria-current="page"] {
        outline: 2px solid Highlight;
        outline-offset: -2px;
      }
    }
  </style>
</head>
<body data-pagefind-ignore="all">
  <p>
    {t('en', 'redirecting')}{' '}
    <a href={target}>{t('en', 'redirectFallback')}</a>.
  </p>
  <details
    class="language-menu legacy-language-menu"
    role="group"
    aria-label={t('en', 'languageNavigation')}
  >
    <summary class="language-menu-summary">
      <span>{LOCALE_DISPLAY_NAMES.en}</span>
    </summary>
    <ul class="language-menu-list">
      {localeLinks.map(({ locale, href }) => (
        <li>
          <a
            href={href}
            lang={HTML_LANG[locale]}
            hreflang={locale}
            data-locale-link={locale}
            aria-current={locale === 'en' ? 'page' : undefined}
          >{LOCALE_DISPLAY_NAMES[locale]}</a>
        </li>
      ))}
    </ul>
  </details>
</body>
</html>
