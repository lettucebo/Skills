---
import '../styles/global.css';
import {
  BUILD_TIME,
  BUILD_COMMIT_SHORT,
  BUILD_COMMIT_URL,
  formatUtc,
} from '../lib/build-info.ts';
import {
  HTML_LANG,
  LOCALE_DISPLAY_NAMES,
  SUPPORTED_LOCALES,
  localizedPath,
  routeForLocale,
  t,
  type Locale,
} from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
}

const { title, locale, description = t(locale, 'siteDescription') } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const buildTimeLabel = formatUtc(BUILD_TIME);
const canonical = new URL(currentPath, Astro.site);
const localeLinks = SUPPORTED_LOCALES.map((targetLocale) => ({
  locale: targetLocale,
  href: routeForLocale(targetLocale, currentPath),
  canonical: new URL(routeForLocale(targetLocale, currentPath), Astro.site),
}));
const homePath = localizedPath(locale);
const installPath = localizedPath(locale, 'install');
const statusPath = localizedPath(locale, 'status');
const themeLabels = {
  light: t(locale, 'themeLight'),
  dark: t(locale, 'themeDark'),
  system: t(locale, 'themeSystem'),
};

function isActive(href: string): boolean {
  const norm = (p: string) => p.replace(/\/+$/, '') || '/';
  return norm(currentPath) === norm(href);
}
---
<!doctype html>
<html lang={HTML_LANG[locale]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} | {t(locale, 'titleSuffix')}</title>
  <link rel="canonical" href={canonical} />
  {localeLinks.map((link) => (
    <link rel="alternate" hreflang={link.locale} href={link.canonical} />
  ))}
  <script is:inline>
    (() => {
      // Pre-paint theme resolution (runs before first paint to avoid FOUC).
      // Precedence: scoutTheme URL param > persisted choice > system preference.
      // "System" is modelled as the ABSENCE of the localStorage key.
      const STORAGE_KEY = "skills-theme";
      let stored = null;
      try {
        const value = localStorage.getItem(STORAGE_KEY);
        if (value === "light" || value === "dark") stored = value;
      } catch (e) { /* localStorage may throw in private modes */ }
      const rawParam = new URLSearchParams(window.location.search).get("scoutTheme");
      const param = rawParam === "light" || rawParam === "dark" ? rawParam : null;
      const theme = param
        || stored
        || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body>
  <a href="#main-content" class="skip-link">{t(locale, 'skipToMain')}</a>

  <header class="site-header" role="banner">
    <nav aria-label={t(locale, 'mainNavigation')}>
      <a href={homePath} class="site-title">{t(locale, 'catalogHeading')}</a>
      <ul class="nav-links">
        <li><a href={homePath} aria-current={isActive(homePath) ? 'page' : undefined}>{t(locale, 'navCatalog')}</a></li>
        <li><a href={installPath} aria-current={isActive(installPath) ? 'page' : undefined}>{t(locale, 'navInstall')}</a></li>
        <li><a href={statusPath} aria-current={isActive(statusPath) ? 'page' : undefined}>{t(locale, 'navStatus')}</a></li>
        <li><a href="https://github.com/lettucebo/Skills" rel="noopener noreferrer">{t(locale, 'navGitHub')}</a></li>
      </ul>
      <div class="language-switcher" aria-label={t(locale, 'languageNavigation')}>
        {localeLinks.map((link) => (
          <a
            href={link.href}
            data-locale-link={link.locale}
            aria-current={link.locale === locale ? 'page' : undefined}
          >{LOCALE_DISPLAY_NAMES[link.locale]}</a>
        ))}
      </div>
      <noscript>
        <style>.theme-toggle { display: none !important; }</style>
      </noscript>
      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle"
        aria-label={t(locale, 'themeLabel', {
          current: themeLabels.system,
          next: themeLabels.light,
        })}
      >
        <span class="theme-toggle-icon" data-theme-icon aria-hidden="true">◐</span>
        <span class="theme-toggle-label" data-theme-label>{themeLabels.system}</span>
      </button>
    </nav>
    <script define:vars={{ themeLabels, themeLabelTemplate: t(locale, 'themeLabel') }}>
      (() => {
        const STORAGE_KEY = "skills-theme";
        const root = document.documentElement;
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;

        const iconEl = btn.querySelector("[data-theme-icon]");
        const labelEl = btn.querySelector("[data-theme-label]");
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const LABELS = themeLabels;
        const ICONS = { light: "\u2600", dark: "\u263E", system: "\u25D0" };
        // Light -> Dark -> System -> Light
        const NEXT = { light: "dark", dark: "system", system: "light" };

        function readStored() {
          try {
            const value = localStorage.getItem(STORAGE_KEY);
            return value === "light" || value === "dark" ? value : null;
          } catch (e) {
            return null;
          }
        }

        function readParam() {
          const raw = new URLSearchParams(window.location.search).get("scoutTheme");
          return raw === "light" || raw === "dark" ? raw : null;
        }

        function writeStored(choice) {
          try {
            if (choice === "system") localStorage.removeItem(STORAGE_KEY);
            else localStorage.setItem(STORAGE_KEY, choice);
          } catch (e) { /* ignore persistence failures */ }
        }

        function systemTheme() {
          return media.matches ? "dark" : "light";
        }

        // Authoritative in-memory choice, resolved with the SAME precedence as the
        // pre-paint head script: valid scoutTheme override > valid stored choice >
        // System. It is then advanced on every click regardless of whether
        // persistence works, so the control keeps cycling even when localStorage
        // throws. A valid URL override is an explicit light/dark value, so live OS
        // changes (which only re-apply in System mode) never overwrite it.
        let activeChoice = readParam() || readStored() || "system";

        function resolvedTheme(choice) {
          return choice === "system" ? systemTheme() : choice;
        }

        function applyTheme(choice) {
          root.setAttribute("data-theme", resolvedTheme(choice));
        }

        function render() {
          const next = NEXT[activeChoice];
          btn.setAttribute("data-theme-choice", activeChoice);
          btn.setAttribute(
            "aria-label",
            themeLabelTemplate
              .replace("{current}", LABELS[activeChoice])
              .replace("{next}", LABELS[next]),
          );
          if (iconEl) iconEl.textContent = ICONS[activeChoice];
          if (labelEl) labelEl.textContent = LABELS[activeChoice];
        }

        // Follow live OS changes only while in System mode.
        media.addEventListener("change", () => {
          if (activeChoice === "system") {
            applyTheme("system");
            render();
          }
        });

        btn.addEventListener("click", () => {
          activeChoice = NEXT[activeChoice];
          writeStored(activeChoice);
          applyTheme(activeChoice);
          render();
        });

        render();
      })();
    </script>
    <script>
      document.querySelectorAll('[data-locale-link]').forEach((link) => {
        link.addEventListener('click', () => {
          const selected = link.getAttribute('data-locale-link');
          try {
            if (selected) localStorage.setItem('skillsLocale', selected);
          } catch {}
        });
      });
    </script>
  </header>

  <main id="main-content" class="site-main" role="main" tabindex="-1">
    <slot />
  </main>

  <footer class="site-footer" role="contentinfo">
    <p>{t(locale, 'catalogHeading')} &mdash; {t(locale, 'footerTagline')}</p>
    <p class="build-info">
      {t(locale, 'siteBuilt')} <time datetime={BUILD_TIME}>{buildTimeLabel}</time>{
        BUILD_COMMIT_SHORT && BUILD_COMMIT_URL && (
          <Fragment>
            {' · '}
            <a href={BUILD_COMMIT_URL} rel="noopener noreferrer"><code>{BUILD_COMMIT_SHORT}</code></a>
          </Fragment>
        )
      }
    </p>
  </footer>
</body>
</html>
